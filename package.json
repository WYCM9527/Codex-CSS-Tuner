{
  "name": "css-tuner-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @css-tuner/bridge build && pnpm --filter @css-tuner/panel build && pnpm --filter cursor-css-tuner build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "package": "pnpm build && pnpm --filter cursor-css-tuner package"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
