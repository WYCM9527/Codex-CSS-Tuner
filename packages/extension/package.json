{
  "name": "cursor-css-tuner",
  "displayName": "Cursor CSS Tuner",
  "description": "在 Cursor 内置浏览器里点选元素、可视化调 CSS、实时预览，确定性写回源码并可逐条还原。",
  "version": "0.1.0",
  "publisher": "WYCM9527",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYCM9527/Cursor-CSS-Tuner.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/WYCM9527/Cursor-CSS-Tuner#readme",
  "bugs": {
    "url": "https://github.com/WYCM9527/Cursor-CSS-Tuner/issues"
  },
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#15171c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "cursor",
    "css",
    "tailwind",
    "visual editor",
    "design"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cssTuner",
          "title": "CSS Tuner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cssTuner": [
        {
          "type": "webview",
          "id": "cssTuner.panel",
          "name": "调参"
        }
      ]
    },
    "commands": [
      { "command": "cssTuner.openPage", "title": "打开页面", "category": "CSS Tuner" },
      { "command": "cssTuner.togglePick", "title": "选取元素", "category": "CSS Tuner" },
      { "command": "cssTuner.applyAll", "title": "应用全部改动", "category": "CSS Tuner" },
      { "command": "cssTuner.serveStatic", "title": "用内置静态服务打开 HTML", "category": "CSS Tuner" },
      { "command": "cssTuner.handoff", "title": "把未处理的改动交给 Agent", "category": "CSS Tuner" },
      { "command": "cssTuner.selfCheck", "title": "自检", "category": "CSS Tuner" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "cssTuner.serveStatic", "when": "resourceExtname == .html || resourceExtname == .htm || explorerResourceIsFolder", "group": "navigation@90" }
      ]
    },
    "configuration": {
      "title": "CSS Tuner",
      "properties": {
        "cssTuner.defaultUrl": {
          "type": "string",
          "default": "http://localhost:5173/",
          "description": "打开页面时的默认地址。"
        },
        "cssTuner.remBase": {
          "type": "number",
          "default": 16,
          "description": "rem 与 px 换算的基准字号。"
        },
        "cssTuner.tailwind.scope": {
          "type": "string",
          "enum": ["instance", "source"],
          "enumDescriptions": ["只改当前 JSX 调用位置的 className", "改类名的源头（组件定义处），影响所有使用它的地方"],
          "default": "instance",
          "description": "Tailwind 改动默认的作用范围。"
        },
        "cssTuner.tailwind.arbitraryValues": {
          "type": "string",
          "enum": ["allow", "agent"],
          "enumDescriptions": ["刻度外的值写成任意值类名（如 px-[13.5px]）", "刻度外的值不写任意值类名，交给 Agent"],
          "default": "allow",
          "description": "Tailwind 改动的值不在主题刻度上时怎么写回。"
        },
        "cssTuner.css.strategy": {
          "type": "string",
          "enum": ["editRule", "agent"],
          "enumDescriptions": ["直接改命中的 CSS 规则", "不直接写回，交给 Agent"],
          "default": "editRule",
          "description": "语义 CSS 改动的写回策略。"
        },
        "cssTuner.vars.strategy": {
          "type": "string",
          "enum": ["editDefinition", "agent"],
          "enumDescriptions": ["直接改变量的定义处（Tailwind 改 @theme），用到它的地方一起变", "不直接写回，交给 Agent"],
          "default": "editDefinition",
          "description": "CSS 变量改动的写回策略。"
        },
        "cssTuner.snap": {
          "type": "boolean",
          "default": true,
          "description": "数值吸附到主题刻度和 CSS 变量（按住 Alt 写精确值）。"
        },
        "cssTuner.verifyTimeoutMs": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "description": "应用后等待热更新并校验计算样式的超时时间（毫秒）。超时的改动会在后台再等一轮，热更新晚到时自动改成已生效。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out dist/cursor-css-tuner.vsix",
    "publish:ovsx": "ovsx publish dist/cursor-css-tuner.vsix"
  },
  "dependencies": {
    "@css-tuner/engine": "workspace:*",
    "@css-tuner/protocol": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@css-tuner/bridge": "workspace:*",
    "@css-tuner/panel": "workspace:*",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0"
  }
}
