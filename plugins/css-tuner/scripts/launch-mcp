#!/bin/sh
# Start the CSS Tuner MCP server with Node 20+ from PATH, or else Codex's bundled Node.
# PATH comes first because it's the Node the project's dev server runs on, so it can load the
# project's native modules (Tailwind 4 needs lightningcss). On macOS the Codex app's cua_node
# refuses native modules signed by anyone else, so it is the last resort.
set -eu

if [ "$#" -lt 1 ]; then
  printf '%s\n' 'CSS Tuner could not start: missing MCP server path.' >&2
  exit 64
fi

PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

if [ -n "${CSS_TUNER_NODE:-}" ] && [ -x "$CSS_TUNER_NODE" ]; then
  exec "$CSS_TUNER_NODE" "$@"
fi

old_node=
if node_path=$(command -v node 2>/dev/null); then
  case "$node_path" in
    /*)
      if "$node_path" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' 2>/dev/null; then
        exec "$node_path" "$@"
      fi
      old_node="$node_path is $("$node_path" -v 2>/dev/null || echo unknown)"
      ;;
  esac
fi

cache_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}
codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac
for candidate in \
  "$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_BROWSER_USE_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "$codex_resources/cua_node/bin/node" \
  "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node" \
  "/Applications/Codex.app/Contents/Resources/cua_node/bin/node"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

if [ -n "$old_node" ]; then
  printf '%s\n' "CSS Tuner needs Node.js 20 or later; $old_node." >&2
else
  printf '%s\n' 'CSS Tuner could not find a Node runtime. Update Codex, or install Node.js 20 or later.' >&2
fi
exit 127
