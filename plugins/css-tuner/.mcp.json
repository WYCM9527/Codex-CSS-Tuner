{
  "mcpServers": {
    "css-tuner": {
      "command": "./scripts/launch-mcp",
      "args": ["./server/mcp.mjs"],
      "cwd": ".",
      "env_vars": [
        "CSS_TUNER_DATA",
        "CSS_TUNER_NODE",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "XDG_CACHE_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH",
        "LANG",
        "LC_ALL",
        "LC_MESSAGES"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 120
    }
  }
}
